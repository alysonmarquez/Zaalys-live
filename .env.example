# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MediaFlow

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- IA (plugável) ----------
# anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Transcrição de áudio (Raio-X). Hoje só o adaptador OpenAI implementa.
TRANSCRIPTION_PROVIDER=openai

# ---------- Pagamento (plugável) ----------
# mercadopago (outros adaptadores: implemente PaymentProvider em src/lib/payments)
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
# Segredo de assinatura do webhook (painel do Mercado Pago > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# Preços em centavos
PRICE_MONTHLY_CENTS=54000
PRICE_LIFETIME_CENTS=79400
LIFETIME_MAX_INSTALLMENTS=12

# ---------- Push (gere com: npm run vapid) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com
