# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MediaFlowMZ

# De onde vêm as mídias dos templates e do Trend AI que não estão em public/media
# Vazio = mídias de public/media (padrão). Preencha só se for servir de um CDN.
NEXT_PUBLIC_TEMPLATE_MEDIA_ORIGIN=

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- IA (plugável) ----------
# anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Transcrição de áudio (Raio-X). Hoje só o adaptador OpenAI implementa.
TRANSCRIPTION_PROVIDER=openai

# ---------- Pagamento (plugável) ----------
# applyfy (padrão: links de checkout hospedados) | mercadopago
PAYMENT_PROVIDER=applyfy
NEXT_PUBLIC_PAYMENT_PROVIDER=applyfy
# Applyfy: postback em https://SEU-DOMINIO/api/webhooks/payment?token=<este valor> (mín. 16 caracteres)
APPLYFY_WEBHOOK_TOKEN=
# Links das ofertas (opcional: sem preencher, usa os links atuais do código)
# lp = valor cheio (landing/checkout) | creator = com desconto (convites Acesso Creator e Indique)
NEXT_PUBLIC_CHECKOUT_LP_LIFETIME=
NEXT_PUBLIC_CHECKOUT_LP_MONTHLY=
NEXT_PUBLIC_CHECKOUT_CREATOR_LIFETIME=
NEXT_PUBLIC_CHECKOUT_CREATOR_MONTHLY=
# Mercado Pago (só se PAYMENT_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
# Segredo de assinatura do webhook (painel do Mercado Pago > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# Preços em centavos: iguais às ofertas cheias da Applyfy (R$ 340/mês | R$ 594 vitalício)
# Os NEXT_PUBLIC_* precisam ter o mesmo valor: o checkout usa eles no navegador.
PRICE_MONTHLY_CENTS=34000
PRICE_LIFETIME_CENTS=59400
LIFETIME_MAX_INSTALLMENTS=12
NEXT_PUBLIC_PRICE_MONTHLY_CENTS=34000
NEXT_PUBLIC_PRICE_LIFETIME_CENTS=59400
NEXT_PUBLIC_LIFETIME_MAX_INSTALLMENTS=12
# Cupons válidos no vitalício: CODIGO:desconto_em_centavos, separados por vírgula
COUPON_CODES=

# ---------- E-mail (Radar e suporte) ----------
RESEND_API_KEY=
EMAIL_FROM=MediaFlowMZ <radar@mediaflowmz.com>
SUPPORT_INBOX=suporte@mediaflowmz.com
# A Vercel envia este segredo ao chamar /api/cron/radar
CRON_SECRET=

# Painel sem login com dados de exemplo. Liga sozinho em desenvolvimento sem Supabase;
# em produção só com true. Nunca ligue com clientes reais.
ZAALYS_DEMO_MODE=false

# Contas de demonstração (e-mails separados por vírgula). Só elas veem os dados de exemplo
# (dashboard, vendas ao vivo, Estúdio de LIVE, comissões) e as ferramentas de demonstração.
# Vazio = nathalyahoff@gmail.com.
SHOWCASE_EMAILS=nathalyahoff@gmail.com

# ---------- Push (gere com: npm run vapid) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@mediaflowmz.com
