{
  "manifest_version": 3,
  "name": "MediaFlowMZ Live",
  "short_name": "MediaFlowMZ Live",
  "version": "3.17.0",
  "description": "Automatiza sua live no TikTok Shop: clipes em loop como câmera, comentários, produto fixado e respostas ao chat.",
  "icons": { "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "MediaFlowMZ Live" },
  "content_scripts": [
    {
      "matches": ["https://shop.tiktok.com/streamer/*", "http://localhost:3000/estudio/*"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://shop.tiktok.com/streamer/*", "http://localhost:3000/estudio/*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["site-connect.js"],
      "run_at": "document_idle"
    }
  ]
}
